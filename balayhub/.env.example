# Copy to .env and adjust. (Load with your process manager or `export $(cat .env | xargs)`.)
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=postgres://balayhub:balayhub@localhost:5432/balayhub
STORAGE_DIR=./storage

# Transactional email (required in production for verification and password reset)
# SMTP_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM="BalayHub <no-reply@example.com>"

# Sessions
SESSION_TTL_HOURS=168
SESSION_IDLE_HOURS=12

# Set to false only for local demos without email
REQUIRE_EMAIL_VERIFICATION=true
