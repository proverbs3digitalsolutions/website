# Copy to deploy/.env on the server:  cp deploy/.env.production.example deploy/.env
# Then edit with:  nano deploy/.env

# The web address BalayHub will use (its DNS A record must point to this VPS's IP).
DOMAIN=app.example.com

# Database password. Generate one with:  openssl rand -hex 24
# Use letters and numbers only.
DB_PASSWORD=change-me

# Email for verification, password reset and invitations.
# Hostinger email example (URL-encode special characters in the password, e.g. @ -> %40):
# SMTP_URL=smtps://no-reply%40yourdomain.com:YOUR_EMAIL_PASSWORD@smtp.hostinger.com:465
SMTP_URL=
MAIL_FROM=BalayHub <no-reply@yourdomain.com>

# Sign in with Google (optional). See docs/GOOGLE-SIGNIN.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Guest replies in the Inbox (optional). Same mailbox and app password as SMTP_URL. See docs/INBOX-SETUP.md
# IMAP_URL=imaps://admin%40yourdomain.com:YOUR_APP_PASSWORD@imap.gmail.com:993
IMAP_URL=

# AI reply drafts in the Inbox (optional). Key from console.anthropic.com. See docs/INBOX-SETUP.md
ANTHROPIC_API_KEY=

# Your own email(s), comma-separated: can open the platform admin page (#/admin)
PLATFORM_ADMIN_EMAILS=

# Contact email shown on the landing page and in Settings (defaults to the MAIL_FROM address)
SALES_CONTACT_EMAIL=

# Online plan payments through PayMongo (optional). See docs/SELLING.md
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# Days after check-out before guest ID photos are deleted (default 30)
GUEST_ID_RETENTION_DAYS=30

# Optional: key used to encrypt hosts' PayMongo keys in the database. If empty, one is
# generated automatically and kept in the private uploads folder (it's in the uploads backup).
DATA_ENCRYPTION_KEY=

# Keep "true" once SMTP works. Set to "false" ONLY temporarily if email isn't set up yet.
REQUIRE_EMAIL_VERIFICATION=true
