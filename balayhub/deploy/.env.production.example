# Copy to deploy/.env on the server:  cp deploy/.env.production.example deploy/.env
# Then edit with:  nano deploy/.env

# The web address BalayHub will use (its DNS A record must point to this VPS's IP).
DOMAIN=app.example.com

# Database password. Generate one with:  openssl rand -hex 24
# Use letters and numbers only.
DB_PASSWORD=change-me

# Email for verification, password reset and invitations.
# Hostinger email example (URL-encode special characters in the password, e.g. @ -> %40):
# SMTP_URL=smtps://no-reply%40yourdomain.com:YOUR_EMAIL_PASSWORD@smtp.hostinger.com:465
SMTP_URL=
MAIL_FROM=BalayHub <no-reply@yourdomain.com>

# Sign in with Google (optional). See docs/GOOGLE-SIGNIN.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Keep "true" once SMTP works. Set to "false" ONLY temporarily if email isn't set up yet.
REQUIRE_EMAIL_VERIFICATION=true
